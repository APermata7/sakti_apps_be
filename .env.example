# App Config
APP_NAME=sakti_apps_be
APP_ENV=production
APP_PORT=8080

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWKS
SUPABASE_JWT_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_X=your-jwt-x
SUPABASE_JWT_Y=your-jwt-y

# Office
OFFICE_LAT=-7.942777
OFFICE_LON=112.641110
OFFICE_RADIUS=500

# Cloudinary URL
CLOUDINARY_URL=cloudinary://your-cloudinary-api-key:your-cloudinary-api-secret@your-cloud-name

# Cloudinary Komponen
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_FOLDER=sakti-apps

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# CORS
CORS_ALLOWED_ORIGINS=https://adminsakti.kopegtelmalang.co.id,https://sakti-web-fe.vercel.app,http://localhost:5173

# FACE SERVICE
FACE_SERVICE_URL=https://presensi.kopegtelmalang.co.id/

# Frontend URL
FRONTEND_URL=https://adminsakti.kopegtelmalang.co.id

# Reset Password URL
RESET_PASSWORD_URL=sakti://reset-password